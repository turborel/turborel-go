#!/bin/sh
# Every check a change must pass, before each commit (RULES.md R-PROC-1).
# The checks live in `go run ./internal/xtask`; this file only hands over to
# it, because git runs hooks as scripts (on Windows, through the sh Git for
# Windows ships). Install with `go run ./internal/xtask install-hooks`.
exec go run ./internal/xtask verify
